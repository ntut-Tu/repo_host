    "/v1/search": {
      "post": {
        "operationId": "Search_source",
        "summary": "Search source",
        "description": "Line-based literal or Go regexp/RE2 search of regular UTF-8 files under a directory path. Default 100 matches (maximum 1000), 1000 files, 16 MiB scanned bytes and 1 MiB per file. Matching lines longer than 4096 bytes are omitted. complete=false reports work, size or result limits; no continuation. Binary and non-regular entries are outside the search domain and counted in omitted. Symlinks, submodules and LFS content are never expanded.",
        "responses": {
          "200": {
            "description": "Success",
