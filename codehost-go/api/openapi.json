    "/v1/trees/{sha}": {
      "get": {
        "operationId": "Browse_tree",
        "summary": "Browse tree",
        "description": "Paths are literal UTF-8 repository-relative paths without dot components, NUL, CR or LF. Empty path denotes root. Symlinks/submodules are not traversed. Pages are sorted by path; next is passed as cursor with the same SHA, path, recursive and limit. complete means no further page. Traversal is capped at 100000 entries or 16 MiB of entry data; excess returns 413.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tree"
                }
