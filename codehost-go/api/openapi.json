        },
        "parameters": [
          {
            "name": "sha",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recursive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/files/{sha}": {
      "get": {
        "operationId": "Read_file",
        "summary": "Read file",
        "description": "Read UTF-8 text. start/end are inclusive 1-based lines; omitted or zero selects beginning/end. End is clipped to EOF; start beyond EOF is invalid. Empty file returns start=end=0. Newlines are retained. Binary/non-UTF-8 returns 415. Symlinks return link text without following it; LFS returns pointer text. Whole blob size must fit file_bytes even for a line range.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
